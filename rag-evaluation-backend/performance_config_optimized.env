# EvalScope性能优化配置
# 替换现有的 .env 文件中的相关配置

# ===========================================
# 核心性能优化设置
# ===========================================

# 禁用Python API优先，直接使用命令行（更快更稳定）
EVALSCOPE_PREFER_PYTHON_API=false

# 小任务阈值：样本数小于此值时跳过复杂的监控逻辑
EVALSCOPE_SMALL_TASK_THRESHOLD=50

# 进度监控间隔优化
EVALSCOPE_PROGRESS_INTERVAL_SMALL=30      # 小任务：30秒检查一次
EVALSCOPE_PROGRESS_INTERVAL_LARGE=10      # 大任务：10秒检查一次

# 数据库更新频率限制（避免频繁写入）
EVALSCOPE_DB_UPDATE_INTERVAL=5.0          # 至少5秒间隔才更新数据库

# WebSocket超时设置（避免阻塞）
EVALSCOPE_WEBSOCKET_TIMEOUT=1.0           # 1秒超时

# ===========================================
# Celery性能优化
# ===========================================

# Celery worker并发数（根据CPU核心数调整）
CELERY_WORKER_CONCURRENCY=2

# Celery任务超时设置
CELERY_TASK_TIME_LIMIT=3600               # 1小时硬超时
CELERY_TASK_SOFT_TIME_LIMIT=3300          # 55分钟软超时

# ===========================================
# 数据库性能优化
# ===========================================

# 使用SQLite以获得更好的单机性能（可选）
USE_SQLITE=true

# SQLite性能优化设置
SQLITE_JOURNAL_MODE=WAL                   # Write-Ahead Logging模式
SQLITE_SYNCHRONOUS=NORMAL                 # 平衡性能和安全性
SQLITE_CACHE_SIZE=20000                   # 增加缓存大小

# ===========================================
# 系统资源优化
# ===========================================

# Python路径（指向evalscope环境）
EVALSCOPE_PYTHON_PATH=/Users/Bone/miniconda3/envs/evalscope/bin/python

# 输出目录清理
AUTO_CLEANUP_OLD_OUTPUTS=true             # 自动清理旧的输出文件
MAX_OUTPUT_RETENTION_DAYS=7               # 保留7天内的输出

# ===========================================
# 调试和监控设置
# ===========================================

# 启用详细日志（开发时使用）
EVALSCOPE_VERBOSE_LOGGING=false

# 启用性能监控
EVALSCOPE_ENABLE_PROFILING=false

# ===========================================
# Redis配置（如果使用）
# ===========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery Broker和Backend URLs
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===========================================
# 安全设置
# ===========================================

# 开发环境可以禁用认证（生产环境请启用）
DISABLE_AUTH=true

# 固定的SECRET_KEY（避免重启后token失效）
SECRET_KEY=rag-evaluation-optimized-secret-key-2024

# ===========================================
# 使用说明
# ===========================================

# 1. 将此文件内容复制到 .env 文件中
# 2. 根据实际环境调整路径和设置
# 3. 重启后端服务和Celery worker
# 4. 新创建的评测任务将使用优化版本

# 重启命令示例：
# cd RAGEval/rag-evaluation-backend
# pkill -f celery  # 停止现有worker
# celery -A app.tasks.evalscope_tasks_optimized worker --loglevel=info --concurrency=2 &  # 启动优化版worker
# python -m app.main  # 启动后端服务

