# RAGEval 稳定环境配置文件
# 此文件确保环境变量的一致性

# ============================================
# 核心Python环境配置
# ============================================
# 使用evalscope环境的Python解释器
EVALSCOPE_PYTHON_PATH=/Users/Bone/miniconda3/envs/evalscope/bin/python

# Python路径设置
PYTHONPATH=/Users/Bone/Documents/工作/10月/代码测试区/RAGEval/rag-evaluation-backend

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 数据库配置（生产环境推荐）
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_evaluation

# 数据库URL（优先级最高）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_evaluation

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery性能配置
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# ============================================
# EvalScope 配置
# ============================================
# 性能优化设置
EVALSCOPE_SMALL_TASK_THRESHOLD=100
EVALSCOPE_PREFER_PYTHON_API=false
EVALSCOPE_PROGRESS_INTERVAL_SMALL=10
EVALSCOPE_PROGRESS_INTERVAL_LARGE=2
EVALSCOPE_DB_UPDATE_INTERVAL=1.0
EVALSCOPE_WEBSOCKET_TIMEOUT=0.5

# 调试设置
EVALSCOPE_VERBOSE_LOGGING=false
EVALSCOPE_ENABLE_PROFILING=false

# ============================================
# JWT 和安全配置
# ============================================
SECRET_KEY=rag-evaluation-stable-secret-key-2024

# 管理员账户
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=adminpassword

# 开发环境设置
DISABLE_AUTH=true

# ============================================
# 系统配置
# ============================================
# 环境标识
ENVIRONMENT=stable
APP_NAME=RAGEval
APP_VERSION=1.0.0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=app.log
