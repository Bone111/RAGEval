# RAG Evaluation Backend 配置文件
# ============================================

# PostgreSQL 数据库配置（生产环境推荐）
# ============================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_evaluation

# 数据库URL（优先级最高，直接指定使用PostgreSQL）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_evaluation

# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 配置
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production

# 管理员账户（首次初始化时创建）
# ============================================
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=adminpassword

# EvalScope 性能优化配置
# ============================================
EVALSCOPE_SMALL_TASK_THRESHOLD=100
EVALSCOPE_PREFER_PYTHON_API=false
EVALSCOPE_PROGRESS_INTERVAL_SMALL=10
EVALSCOPE_PROGRESS_INTERVAL_LARGE=2
EVALSCOPE_DB_UPDATE_INTERVAL=1.0
EVALSCOPE_WEBSOCKET_TIMEOUT=0.5

# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
