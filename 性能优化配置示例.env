# =============================================================================
# EvalScope 性能优化配置示例
# =============================================================================
# 使用方法：将此文件的内容复制到 rag-evaluation-backend/.env 文件中
# =============================================================================

# -----------------------------------------------------------------------------
# 性能优化配置（推荐用于所有环境）
# -----------------------------------------------------------------------------

# 小任务阈值：样本数小于此值时使用快速路径
# - 默认：100
# - 建议：开发环境100，生产环境50
# - 说明：样本数小于此值时，自动跳过Python API，直接使用命令行模式
EVALSCOPE_SMALL_TASK_THRESHOLD=100

# 是否优先使用Python API
# - 默认：false（优先使用命令行，性能更好）
# - true：总是尝试Python API（更详细的错误信息）
# - false：小任务直接用命令行（更快）
EVALSCOPE_PREFER_PYTHON_API=false

# 进度监控间隔 - 小任务（秒）
# - 默认：10秒
# - 建议：5-20秒
# - 说明：小任务使用较长间隔，减少文件系统开销
EVALSCOPE_PROGRESS_INTERVAL_SMALL=10

# 进度监控间隔 - 大任务（秒）
# - 默认：2秒
# - 建议：1-5秒
# - 说明：大任务使用较短间隔，提供更实时的进度
EVALSCOPE_PROGRESS_INTERVAL_LARGE=2

# 数据库更新最小间隔（秒）
# - 默认：1.0秒
# - 建议：0.5-2.0秒
# - 说明：避免频繁的数据库写入，采用节流机制
# - 注意：关键进度（0%, 100%）总是会立即更新
EVALSCOPE_DB_UPDATE_INTERVAL=1.0

# WebSocket发送超时（秒）
# - 默认：0.5秒
# - 建议：0.3-1.0秒
# - 说明：WebSocket发送超时后自动放弃，避免阻塞主流程
EVALSCOPE_WEBSOCKET_TIMEOUT=0.5

# -----------------------------------------------------------------------------
# 预设配置方案
# -----------------------------------------------------------------------------

# 方案1：开发环境（快速测试）- 默认配置
# EVALSCOPE_SMALL_TASK_THRESHOLD=100
# EVALSCOPE_PREFER_PYTHON_API=false
# EVALSCOPE_PROGRESS_INTERVAL_SMALL=10
# EVALSCOPE_PROGRESS_INTERVAL_LARGE=2
# EVALSCOPE_DB_UPDATE_INTERVAL=1.0
# EVALSCOPE_WEBSOCKET_TIMEOUT=0.5

# 方案2：生产环境（平衡性能和体验）
# EVALSCOPE_SMALL_TASK_THRESHOLD=50
# EVALSCOPE_PREFER_PYTHON_API=false
# EVALSCOPE_PROGRESS_INTERVAL_SMALL=5
# EVALSCOPE_PROGRESS_INTERVAL_LARGE=2
# EVALSCOPE_DB_UPDATE_INTERVAL=1.0
# EVALSCOPE_WEBSOCKET_TIMEOUT=0.5

# 方案3：高负载环境（极致性能）
# EVALSCOPE_SMALL_TASK_THRESHOLD=200
# EVALSCOPE_PREFER_PYTHON_API=false
# EVALSCOPE_PROGRESS_INTERVAL_SMALL=20
# EVALSCOPE_PROGRESS_INTERVAL_LARGE=5
# EVALSCOPE_DB_UPDATE_INTERVAL=2.0
# EVALSCOPE_WEBSOCKET_TIMEOUT=0.3

# -----------------------------------------------------------------------------
# 优化效果说明
# -----------------------------------------------------------------------------
# 
# 优化后预期性能提升：
# - 5样本任务：   ~30秒 → ~5-10秒  （提升 60-80%）
# - 50样本任务：  ~2分钟 → ~1分钟   （提升 50%）
# - 500样本任务： ~20分钟 → ~18分钟 （提升 10%）
#
# 优化内容：
# ✅ 智能进度监控（根据任务大小自动调整频率）
# ✅ 数据库操作节流（减少70-80%的写入）
# ✅ 非阻塞WebSocket（不再阻塞主流程）
# ✅ 快速执行路径（小任务直接用命令行）
#
# 详细说明请查看：EVALSCOPE性能优化说明.md
# -----------------------------------------------------------------------------

# 使用方法：
# 1. 复制此文件中的配置到 rag-evaluation-backend/.env
# 2. 根据需要调整参数值
# 3. 重启后端服务使配置生效
# 4. 创建测试任务验证优化效果

